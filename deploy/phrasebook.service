[Unit]
Description=Private Phrasebook
After=network.target
[Service]
User=phrasebook
Group=phrasebook
WorkingDirectory=/opt/phrasebook
EnvironmentFile=/etc/phrasebook.env
ExecStart=/opt/phrasebook/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8765 --workers 1 --threads 4 --timeout 90
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/phrasebook
[Install]
WantedBy=multi-user.target
