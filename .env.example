# Set these in your process environment; this file is not auto-loaded.
ALLOWED_HOSTS=localhost,127.0.0.1
AI_PROVIDER=mock
# To enable an HTTPS OpenAI-compatible chat-completions endpoint:
# AI_PROVIDER=compatible
# AI_BASE_URL=https://your-approved-provider.example/v1
# AI_MODEL=your-model
# AI_API_KEY=server-only-secret
# Production additionally requires:
# PRODUCTION=1
# DJANGO_SECRET_KEY=generate-a-long-random-secret
# ALLOWED_HOSTS=your.domain
# CSRF_TRUSTED_ORIGINS=https://your.domain
# DATABASE_PATH=/private-data/private.sqlite3
