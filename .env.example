# Copy this file to `.env` (git-ignored) and fill it in. manage.py loads `.env`
# for local runs; real environment variables still take precedence, and `test`
# ignores it. Production uses the systemd EnvironmentFile instead.
ALLOWED_HOSTS=localhost,127.0.0.1
AI_PROVIDER=mock
#
# OpenRouter (https://openrouter.ai) — an OpenAI-compatible gateway.
# Create a key at https://openrouter.ai/keys and add credit; then:
# AI_PROVIDER=openrouter
# AI_MODEL=anthropic/claude-sonnet-4          # any model slug from openrouter.ai/models
# AI_API_KEY=sk-or-...                        # server only; never shown in the app
# AI_APP_TITLE=SmartPhrase Buddy                     # optional, shows in your OpenRouter activity
# AI_APP_URL=https://your.domain              # optional
#
# Google Gemini (via its OpenAI-compatible endpoint; no code adapter needed).
# Key from https://aistudio.google.com/apikey :
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash        # or gemini-2.5-pro, gemini-2.0-flash, ...
# AI_API_KEY=server-only-secret
# (AI_BASE_URL defaults to https://generativelanguage.googleapis.com/v1beta/openai)
#
# Any other HTTPS OpenAI-compatible /chat/completions endpoint:
# AI_PROVIDER=compatible
# AI_BASE_URL=https://your-approved-provider.example/v1
# AI_MODEL=your-model
# AI_API_KEY=server-only-secret
# Production additionally requires:
# PRODUCTION=1
# DJANGO_SECRET_KEY=generate-a-long-random-secret
# ALLOWED_HOSTS=your.domain
# CSRF_TRUSTED_ORIGINS=https://your.domain
# DATABASE_PATH=/private-data/private.sqlite3
